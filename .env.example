# Copy to `.env` (which is git-ignored) and fill in your key.
# The key is never written into any result file, and `.env` is never committed.

# --- DeepSeek (default provider) -----------------------------------------
DEEPSEEK_API_KEY=sk-replace-me

# --- other OpenAI-compatible providers (only if you switch) --------------
# OPENAI_API_KEY=sk-replace-me
# DASHSCOPE_API_KEY=sk-replace-me
# LLM_API_KEY=sk-replace-me          # generic fallback

# --- optional defaults, overridable by CLI flags -------------------------
# EXPERIMENT_PROVIDER=deepseek
# EXPERIMENT_MODEL=deepseek-flash
# EXPERIMENT_BASE_URL=https://api.deepseek.com/v1